apiVersion: v1
kind: Secret
metadata:
  name: pr-agent-credentials
type: Opaque
stringData:
  GITHUB_APP_ID: "your_app_id"
  GITHUB_WEBHOOK_SECRET: "your_webhook_secret"
  GITHUB_PRIVATE_KEY: |
    -----BEGIN RSA PRIVATE KEY-----
    ...
    -----END RSA PRIVATE KEY-----
  OPENAI_KEY: "your_openai_key"
