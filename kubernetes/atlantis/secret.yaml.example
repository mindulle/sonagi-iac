# 실제 배포 시 이 파일을 복사하여 secret.yaml 로 만들고 값을 채우세요.
# 절대로 실제 Secret을 GitHub에 커밋하지 마세요!
apiVersion: v1
kind: Secret
metadata:
  name: atlantis-vcs
  namespace: atlantis
type: Opaque
stringData:
  token: "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx" # GitHub Personal Access Token
  webhook-secret: "YOUR_RANDOM_SECRET_STRING" # GitHub Webhook 생성 시 입력할 Secret
