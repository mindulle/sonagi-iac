apiVersion: 1
contactPoints:
  - orgId: 1
    name: Discord Alerts
    receivers:
      - uid: discord-receiver-1
        type: discord
        settings:
          url: "{{ discord_webhook_url }}"
  # severity=critical 은 #sonagi-ops 로 보내 사람이 바로 보게 한다.
  - orgId: 1
    name: Discord Ops
    receivers:
      - uid: discord-receiver-ops
        type: discord
        settings:
          url: "{{ discord_ops_webhook_url }}"
policies:
  - orgId: 1
    receiver: Discord Alerts
    group_by: ['grafana_folder', 'alertname']
    routes:
      - receiver: Discord Ops
        object_matchers: [['severity', '=', 'critical']]
        group_by: ['grafana_folder', 'alertname']
        repeat_interval: 4h

# Grafana 12+ 는 최상위 `rules:` 대신 `groups:` 아래에 규칙을 둔다.
# (최상위 rules 형식은 조용히 무시되어 규칙이 0개로 남는다 — 2026-11 실제 발생)
groups:
  - orgId: 1
    name: OpenHands Error Alerts
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: openhands-error-rule
        title: OpenHands Error Log Detected
        condition: A
        noDataState: OK
        execErrState: Error
        for: 5m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "OpenHands 컨테이너에서 에러 로그가 반복 발생"
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ grafana_loki_datasource_uid }}"
            model:
              expr: 'rate({container="openhands"} |= "error" [5m]) > 0 or rate({container="openhands"} |= "exception" [5m]) > 0'
              queryType: range

  - orgId: 1
    name: Infrastructure
    folder: Infrastructure
    interval: 1m
    rules:
      - uid: node-exporter-down
        title: Node exporter down
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          severity: critical
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.instance }} 의 node_exporter 가 5분 이상 응답 없음{% endraw %}"
          description: "호스트 자체가 내려갔거나 node_exporter가 죽었습니다. `up{job=\"node_exporter\"} == 0`."
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'up{job="node_exporter"} == 0'
              instant: true
              legendFormat: "{{ '{{' }}instance{{ '}}' }}"
              range: false

      - uid: disk-usage-high
        title: Disk usage above 85%
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 10m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.instance }} 루트 디스크 사용률 85% 초과{% endraw %}"
          description: "{% raw %}현재 {{ $values.A }}%. safe prune 또는 볼륨 정리가 필요합니다.{% endraw %}"
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: '(1 - node_filesystem_avail_bytes{mountpoint="/",fstype=~"ext4|xfs"} / node_filesystem_size_bytes{mountpoint="/",fstype=~"ext4|xfs"}) * 100 > 85'
              instant: true
              legendFormat: "{{ '{{' }}instance{{ '}}' }}"
              range: false

      - uid: tls-cert-expiring
        title: TLS certificate expires within 14 days
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 1h
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.target }} TLS 인증서 만료 14일 이내{% endraw %}"
          description: "{% raw %}blackbox probe 기준 잔여 시간(초): {{ $values.A }}{% endraw %}"
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'probe_ssl_earliest_cert_expiry - time() < 14 * 24 * 3600'
              instant: true
              legendFormat: "{{ '{{' }}target{{ '}}' }}"
              range: false

      - uid: https-probe-failing
        title: HTTPS endpoint probe failing
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 15m
        isPaused: false
        labels:
          severity: critical
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.target }} HTTPS 프로브 15분 이상 실패{% endraw %}"
          description: "blackbox `http_any` 모듈 기준 2xx/3xx/401/403 이 아닙니다. 502·404·timeout 은 실제 장애로 봅니다."
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'probe_success{job="blackbox_tls"} == 0'
              instant: true
              legendFormat: "{{ '{{' }}target{{ '}}' }}"
              range: false

      - uid: cloudflared-metrics-down
        title: Cloudflared metrics target down
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          severity: critical
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "edge-gateway cloudflared 메트릭 5분 이상 수집 불가"
          description: "터널이 끊겼거나 cloudflared 프로세스가 죽었습니다."
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'up{job="cloudflared"} == 0'
              instant: true
              legendFormat: "{{ '{{' }}instance{{ '}}' }}"
              range: false

      - uid: memory-available-low
        title: Memory available below 10%
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 10m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.instance }}{% endraw %} 가용 메모리 10% 미만"
          description: "OOM 위험. 프로세스 회수 또는 노드 증설이 필요합니다."
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: '(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 < 10'
              instant: true
              legendFormat: "{{ '{{' }}instance{{ '}}' }}"
              range: false

      - uid: node-load-high
        title: Node load per core above 2
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 15m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.instance }}{% endraw %} 코어당 load 2 초과"
          description: "지속 부하. 어떤 프로세스가 CPU를 잡고 있는지 확인하세요."
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'node_load1 / on(instance) group_left count by (instance) (node_cpu_seconds_total{mode="idle"}) > 2'
              instant: true
              legendFormat: "{{ '{{' }}instance{{ '}}' }}"
              range: false

      - uid: node-exporter-missing
        title: All node_exporter targets missing
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 10m
        isPaused: false
        labels:
          severity: critical
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "node_exporter 타깃이 전부 사라짐"
          description: "Prometheus 설정/scrape가 통째로 깨졌을 가능성이 있습니다. 대시보드가 조용해도 정상이 아닙니다."
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'absent(up{job="node_exporter"})'
              instant: true
              legendFormat: "node_exporter"
              range: false

      - uid: prometheus-reload-failed
        title: Prometheus config reload failed
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 10m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "Prometheus 설정 리로드 실패"
          description: "마지막 설정 적용이 실패했습니다. prometheus.yml 문법과 마운트를 확인하세요."
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'prometheus_config_last_reload_successful == 0'
              instant: true
              legendFormat: "prometheus"
              range: false

      - uid: backup-stale
        title: Backup is stale
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 30m
        isPaused: false
        labels:
          severity: critical
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "datamart 백업이 30시간 이상 갱신되지 않음"
          description: "devops:/mnt/monitoring/llmops_backup/warm_archive 확인. 백업 잡과 디스크 여유를 점검하세요."
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'time() - sonagi_backup_last_success_timestamp_seconds > 30 * 3600'
              instant: true
              legendFormat: "backup"
              range: false

      - uid: container-restarted
        title: Container restarted recently
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.name }}{% endraw %} 컨테이너가 30분 내 2회 이상 재시작됨"
          description: "크래시 루프를 의심하세요. docker logs로 원인을 확인합니다."
        data:
          - refId: A
            relativeTimeRange:
              from: 1800
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'changes(container_start_time_seconds{name=~".+"}[30m]) > 2'
              instant: true
              legendFormat: "{{ '{{' }}name{{ '}}' }}"
              range: false

      - uid: log-fatal
        title: Fatal or panic log line
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          severity: critical
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "docker/pm2 로그에서 fatal/panic 발생"
          description: "Loki에서 해당 라벨·컨테이너를 찾아 스택트레이스를 확인하세요."
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_loki_datasource_uid }}"
            model:
              editorMode: code
              expr: 'sum(rate({job=~"docker|pm2"} | detected_level=~"fatal|panic|critical" [5m])) > 0'
              queryType: range
              legendFormat: "fatal/panic"

      - uid: log-error-spike
        title: Docker log error spike
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 15m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "docker 로그 error 레벨 급증 (초당 0.5건 초과)"
          description: "평시 baseline은 약 0.03/s입니다. detected_level=error 기준이며, 15분 지속 시 어떤 컨테이너인지 확인하세요."
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: "{{ grafana_loki_datasource_uid }}"
            model:
              editorMode: code
              expr: 'sum(rate({job="docker"} | detected_level="error" [5m])) > 0.5'
              queryType: range
              legendFormat: "docker errors"

      - uid: ssh-brute-force
        title: SSH brute force attempt
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 10m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "SSH 인증 실패가 10분간 30회 초과"
          description: "출발지 IP를 확인하고 fail2ban/방화벽 정책을 점검하세요. 정상 baseline은 시간당 약 50회입니다."
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ grafana_loki_datasource_uid }}"
            model:
              editorMode: code
              expr: 'sum(count_over_time({job="varlogs"} |~ "(?i)failed password|invalid user" [10m])) > 30'
              queryType: range
              legendFormat: "ssh auth failures"

      - uid: http-auth-spike
        title: HTTP 401/403 spike
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 15m
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "NPM 401/403 응답이 10분간 50회 초과"
          description: "자격증명 대입 또는 잘못된 클라이언트 설정일 수 있습니다. 어느 host가 맞고 있는지 확인하세요."
        data:
          - refId: A
            relativeTimeRange:
              from: 900
              to: 0
            datasourceUid: "{{ grafana_loki_datasource_uid }}"
            model:
              editorMode: code
              expr: 'sum(count_over_time({job="npm-ingress"} | pattern "<_> - <status> <_>" | status=~"401|403" [10m])) > 50'
              queryType: range
              legendFormat: "401/403"

      - uid: disk-full-forecast
        title: Disk predicted full within 30 days
        condition: A
        noDataState: OK
        execErrState: Alerting
        for: 1h
        isPaused: false
        labels:
          severity: warning
        annotations:
          runbook_url: "https://github.com/mindulle/llm-wiki/blob/main/00_System/OPS_OBSERVABILITY_RUNBOOK.md"
          summary: "{% raw %}{{ $labels.instance }}{% endraw %} 루트 디스크가 30일 내 소진 예상"
          description: "7일 선형 추세 기준입니다. 로그/이미지/백업 증가 원인을 확인하고 정리 계획을 세우세요."
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: "{{ grafana_prometheus_datasource_uid }}"
            model:
              editorMode: code
              expr: 'predict_linear(node_filesystem_avail_bytes{mountpoint="/",fstype=~"ext4|xfs"}[7d], 30*24*3600) < 0'
              instant: true
              legendFormat: "{{ '{{' }}instance{{ '}}' }}"
              range: false
