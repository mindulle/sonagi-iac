# mem0 .env 템플릿 (비밀값 없음)
# 실제 값은 대상 호스트의 /home/ubuntu/mem0/server/.env 에만 둔다.
# 이 파일은 .env 가 없을 때 최초 1회 생성하는 용도이며, 기존 .env 는 덮어쓰지 않는다.

OPENAI_API_KEY=replace-me
# Optional bundled providers
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_COLLECTION_NAME=memories

# Legacy admin header auth (X-API-Key: ADMIN_API_KEY)
ADMIN_API_KEY=replace-me
JWT_SECRET=replace-me
AUTH_DISABLED=false

DASHBOARD_URL=https://llmops-instance.tailb95307.ts.net:9443
DASHBOARD_URLS=https://llmops-instance.tailb95307.ts.net:9443,https://mem0.lab.sonagi.space
APP_DB_NAME=mem0_app
NEXT_PUBLIC_API_URL=https://llmops-instance.tailb95307.ts.net:7443
API_INTERNAL_URL=http://mem0:8000

MEM0_DEFAULT_LLM_MODEL=antigravity-gemini-3-pro
MEM0_DEFAULT_EMBEDDER_MODEL=models/gemini-embedding-001
MEM0_TELEMETRY=false
REQUEST_LOG_RETENTION_DAYS=30

NEO4J_AUTH=neo4j/replace-me
QUARTZ_DIR_HOST=/home/ubuntu/syncthing/digital-garden/content
QUARTZ_DIR_CONTAINER=/sync/quartz

MEM0_DEFAULT_LLM_PROVIDER=openai
MEM0_DEFAULT_EMBEDDER_PROVIDER=gemini
OPENAI_API_BASE=http://172.17.0.1:8000/v1
