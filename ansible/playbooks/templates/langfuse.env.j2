# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ db_password }}
POSTGRES_DB=langfuse

# Langfuse Database Connection String
DATABASE_URL=postgresql://postgres:{{ db_password }}@db:5432/langfuse

# Langfuse Security & Auth
# 웹브라우저에서 접근할 실제 도메인 (Cloudflare Tunnel 사용 시 해당 도메인 입력)
NEXTAUTH_URL=https://langfuse.sonagi.space
NEXTAUTH_SECRET={{ nextauth_secret }}
SALT={{ salt }}

# Optional: Opt-out of anonymous telemetry
TELEMETRY_ENABLED=false

# Cloudflare Tunnel Token (외부 접속용)
TUNNEL_TOKEN={{ cloudflare_tunnel_token }}
